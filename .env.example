# Base URL of the padelontour-api backend.
# When testing on a physical device or simulator, "localhost" won't reach
# your machine — use your LAN IP instead (e.g. http://192.168.1.10:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Google Sign-In (native, @react-native-google-signin/google-signin).
# Create OAuth client IDs at https://console.cloud.google.com/apis/credentials
# - Web client ID: required, this is what actually lets the library return
#   an idToken. Send this same value to the backend for GOOGLE_CLIENT_IDS.
# - iOS client ID: optional; without it the library falls back to reading
#   GoogleService-Info.plist (which this project doesn't have yet).
# The "Continuar con Google" button stays hidden until EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
